#!name=汽水音乐净化测试版
#!desc=仅测试 Shadowrocket URL Rewrite 和 MITM 是否生效；不包含 JSON 正文改写
#!author=@ddgksf2013 / Shadowrocket test port
#!version=V1.0.6-test3
#!url-regex=6
#!mitm=3
#!total=9

[URL Rewrite]
# 视频广告
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/media_ads _ REJECT-200

# 通用广告
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/ads _ REJECT-200

# 位置隐私
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/location\/info _ REJECT-200

# 广告弹窗
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/commerce _ REJECT-200

# TAGS推荐
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/hashtag\/recommend _ REJECT-200

# DNS处理
^https:\/\/tnc.*zijieapi\.com\/get_domains _ REJECT-200

[MITM]
hostname = %APPEND% beta-luna.douyin.com, api.qishui.com, *.zijieapi.com
